# Azure AD Configuration Sample
# Copy this file to .env and replace the placeholder values with your actual Azure AD configuration

# Azure AD Tenant ID
# Find this in Azure Portal > Azure Active Directory > Overview > Tenant ID
TENANT_ID=your-azure-tenant-id-here

# API Application Client ID
# This is the client ID of your registered Azure AD application for the API
API_CLIENT_ID=your-api-application-client-id-here

# MCP Client ID (if different from API_CLIENT_ID)
# This is the client ID for the MCP server authentication
MCP_CLIENT_ID=your-mcp-client-id-here

# OAuth2 Scope for the API
# Format: api://your-app-id/scope-name
SCOPE=api://your-app-id/User.CallApi

# API Scopes Configuration (JSON format)
# Define the scopes that your API accepts
API_SCOPES={"api://your-app-id/User.CallApi": "User.CallApi"}

# Optional: Frontend Client ID (if you have a separate frontend application)
# FE_CLIENT_ID=your-frontend-client-id-here

# Optional: Additional environment-specific settings
# DEBUG=true
# LOG_LEVEL=INFO